{
    "name": "php-internal/actions",
    "description": "Shared GitHub Actions for php-internal packages.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "llm/skills": "^1.3",
        "spiral/code-style": "^2.3",
        "testo/testo": "^0.10.46"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "llm/skills": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "testo",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v"
    }
}
